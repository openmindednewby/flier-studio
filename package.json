{
  "name": "flier-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flier Studio: event fliers and wallpapers rendered in the browser (fliers.dloizides.com).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pwa-sw-gen ./pwa-sw.config.cjs ./dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "measure:prompts": "vite-node scripts/measure-prompts.ts",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@dloizides/background-removal": "^0.1.1",
    "@dloizides/design-tokens": "^1.17.0",
    "@dloizides/llm-run": "^0.2.0",
    "@dloizides/poster-render": "^0.4.0",
    "@dloizides/save-state": "^1.7.0",
    "@dloizides/ui-motion": "^1.3.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "@wllama/wllama": "^3.6.1"
  },
  "devDependencies": {
    "@dloizides/e2e-helpers": "^1.1.0",
    "@dloizides/frontend-devtools": "^2.2.0",
    "@dloizides/pwa-sw": "^1.7.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.13.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.0",
    "vite-node": "^2.1.0",
    "vitest": "^2.1.0"
  }
}
